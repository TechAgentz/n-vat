# Supabase (recommended) — replace ref, region, password
# Session pooler URL from Dashboard -> Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# OR local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nvat?schema=public"

NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
AUTH_SECRET="change-me-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional: Supabase public URL (not required by this app)
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
